  "gensokyolegacy/marisa/brewing/dialog/marisa/brewing/complete/dialog_1": "Jackpot! Blaze rods and nether wart — now I can finally study this 'brewstand' business. You're the best research assistant a magician could ask for, ze!",
  "gensokyolegacy/marisa/brewing/dialog/marisa/brewing/follow_up/dialog_1": "Got any blaze rods or wart yet? I'm itchin' to fire up a brewing stand!",
  "gensokyolegacy/marisa/brewing/dialog/marisa/brewing/start/dialog_1": "Hold up! You mentioned *blazes* down there, right? And nether wart? The folks in this world figured out how to brew potions from scratch — a whole native potion system! Can ya imagine? I *gotta* understand it. I hear ya need a blaze rod to power a brewing stand, and nether wart to make the base. Bring me samples of both, and I'll reverse-engineer this 'Minecraft brewing' thing in no time!",
  "gensokyolegacy/marisa/brewing/option/complete": "Hand over the brewing ingredients.",
  "gensokyolegacy/marisa/brewing/option/complete/handover": "Anything for magic.",
  "gensokyolegacy/marisa/brewing/option/follow_up": "About the brewing ingredients.",
  "gensokyolegacy/marisa/brewing/option/follow_up/end": "Blazes keep melting me.",
  "gensokyolegacy/marisa/brewing/option/start": "Talk about the native potion system.",
  "gensokyolegacy/marisa/brewing/option/start/accept": "I'll get you the samples.",
  "gensokyolegacy/marisa/brewing/option/start/reject": "Blazes are tough to fight.",
  "gensokyolegacy/marisa/brewing/quest/desc": "Bring Marisa blaze rods and nether wart.",
  "gensokyolegacy/marisa/brewing/quest/title": "Brewing the Minecraft Way",
  "gensokyolegacy/marisa/chat/dialog/marisa/chat/hi": "Yo! What can I do for ya, human?",
  "gensokyolegacy/marisa/chat/greeting": "Yo, human! Marisa Kirisame, the ordinary magician, at your service! Ze!",
  "gensokyolegacy/marisa/chat/option/chat/bye": "Bye!",
  "gensokyolegacy/marisa/chat/starter/start": "Yo, human! Marisa Kirisame, the ordinary magician, at your service! Ze!",
  "gensokyolegacy/marisa/chat/trade": "Take a look, human! I've got some good stuff today, ze.",
  "gensokyolegacy/marisa/daily_brewing/dialog/marisa/daily_brewing/complete/dialog_1": "The brew thanks you, human!",
  "gensokyolegacy/marisa/daily_brewing/dialog/marisa/daily_brewing/follow_up/dialog_1": "Still gatherin'? The brew's waitin' on ya!",
  "gensokyolegacy/marisa/daily_brewing/dialog/marisa/daily_brewing/start/dialog_1": "Brewin' up a storm over here, and I'm fresh outta base ingredients! Skedaddle to the Nether and grab me some blaze rods and nether wart, willya? There's a good human!",
  "gensokyolegacy/marisa/daily_brewing/option/complete": "I've got the goods!",
  "gensokyolegacy/marisa/daily_brewing/option/complete/handover": "Here you go!",
  "gensokyolegacy/marisa/daily_brewing/option/follow_up": "How's it going?",
  "gensokyolegacy/marisa/daily_brewing/option/follow_up/end": "I'm on it!",
  "gensokyolegacy/marisa/daily_brewing/option/start": "I can gather that for you.",
  "gensokyolegacy/marisa/daily_brewing/option/start/accept": "I'll do it!",
  "gensokyolegacy/marisa/daily_brewing/option/start/reject": "Maybe later.",
  "gensokyolegacy/marisa/daily_brewing/quest/desc": "Bring Marisa blaze rods and nether wart.",
  "gensokyolegacy/marisa/daily_brewing/quest/title": "Brewing Errand",
  "gensokyolegacy/marisa/daily_mycelium/dialog/marisa/daily_mycelium/complete/dialog_1": "Oh, these are perfect! Thanks, human!",
  "gensokyolegacy/marisa/daily_mycelium/dialog/marisa/daily_mycelium/follow_up/dialog_1": "Take your time, human — but don't skimp on me, now!",
  "gensokyolegacy/marisa/daily_mycelium/dialog/marisa/daily_mycelium/start/dialog_1": "Morning, human! My stock's runnin' low again. Bring me a fresh bundle of this world's specialty mushrooms — the glowing ones, the dreamy ones, whatever ya can find. Fresh research material, stat!",
  "gensokyolegacy/marisa/daily_mycelium/option/complete": "I've got the goods!",
  "gensokyolegacy/marisa/daily_mycelium/option/complete/handover": "Here you go!",
  "gensokyolegacy/marisa/daily_mycelium/option/follow_up": "How's it going?",
  "gensokyolegacy/marisa/daily_mycelium/option/follow_up/end": "I'm on it!",
  "gensokyolegacy/marisa/daily_mycelium/option/start": "I can gather that for you.",
  "gensokyolegacy/marisa/daily_mycelium/option/start/accept": "I'll do it!",
  "gensokyolegacy/marisa/daily_mycelium/option/start/reject": "Maybe later.",
  "gensokyolegacy/marisa/daily_mycelium/quest/desc": "Bring Marisa fresh specialty mushrooms.",
  "gensokyolegacy/marisa/daily_mycelium/quest/title": "Specialty Mushrooms",
  "gensokyolegacy/marisa/daily_shroomlight/dialog/marisa/daily_shroomlight/complete/dialog_1": "Ah, perfect! Thanks, scout!",
  "gensokyolegacy/marisa/daily_shroomlight/dialog/marisa/daily_shroomlight/follow_up/dialog_1": "Still out in the Nether, human? Don't become a mushroom!",
  "gensokyolegacy/marisa/daily_shroomlight/dialog/marisa/daily_shroomlight/start/dialog_1": "Hey, human! I need more of those glowing mushrooms and shroomlights from the Nether. You're my personal Nether scout now, ze! Make a quick trip and bring 'em back.",
  "gensokyolegacy/marisa/daily_shroomlight/option/complete": "I've got the goods!",
  "gensokyolegacy/marisa/daily_shroomlight/option/complete/handover": "Here you go!",
  "gensokyolegacy/marisa/daily_shroomlight/option/follow_up": "How's it going?",
  "gensokyolegacy/marisa/daily_shroomlight/option/follow_up/end": "I'm on it!",
  "gensokyolegacy/marisa/daily_shroomlight/option/start": "I can gather that for you.",
  "gensokyolegacy/marisa/daily_shroomlight/option/start/accept": "I'll do it!",
  "gensokyolegacy/marisa/daily_shroomlight/option/start/reject": "Maybe later.",
  "gensokyolegacy/marisa/daily_shroomlight/quest/desc": "Bring Marisa shroomlights and crimson fungus.",
  "gensokyolegacy/marisa/daily_shroomlight/quest/title": "Nether Light Run",
  "gensokyolegacy/marisa/daily_witchcraft/dialog/marisa/daily_witchcraft/complete/dialog_1": "Just what I needed for the brew, human! Thanks!",
  "gensokyolegacy/marisa/daily_witchcraft/dialog/marisa/daily_witchcraft/follow_up/dialog_1": "Take your time, human — but don't skimp on me, now!",
  "gensokyolegacy/marisa/daily_witchcraft/dialog/marisa/daily_witchcraft/start/dialog_1": "Yo, human! I'm mid-brew and I'm runnin' short on the gross stuff. Think ya can scrounge up some rotten flesh, spider eyes, and a few of those miasma mushrooms? For, uh... research. Yeah. Research.",
  "gensokyolegacy/marisa/daily_witchcraft/option/complete": "I've got the goods!",
  "gensokyolegacy/marisa/daily_witchcraft/option/complete/handover": "Here you go!",
  "gensokyolegacy/marisa/daily_witchcraft/option/follow_up": "How's it going?",
  "gensokyolegacy/marisa/daily_witchcraft/option/follow_up/end": "I'm on it!",
  "gensokyolegacy/marisa/daily_witchcraft/option/start": "I can gather that for you.",
  "gensokyolegacy/marisa/daily_witchcraft/option/start/accept": "I'll do it!",
  "gensokyolegacy/marisa/daily_witchcraft/option/start/reject": "Maybe later.",
  "gensokyolegacy/marisa/daily_witchcraft/quest/desc": "Bring Marisa rotten flesh, spider eyes, and miasma mushrooms.",
  "gensokyolegacy/marisa/daily_witchcraft/quest/title": "Witchcraft Bits",
  "gensokyolegacy/marisa/first_mushroom/dialog/marisa/first_mushroom/complete/dialog_1": "Ohoho, these are perfect! Just the right moisture and bite. This'll jump-start my research something fierce!",
  "gensokyolegacy/marisa/first_mushroom/dialog/marisa/first_mushroom/follow_up/dialog_1": "Got 'em yet? I can practically taste the potion potential!",
  "gensokyolegacy/marisa/first_mushroom/dialog/marisa/first_mushroom/start/dialog_1": "Ah, a new human! Marisa Kirisame, the ordinary magician, zo! This whole world's still fresh to me — even the grass smells different. Say, you live around here, right? I'm just getting my magic research started, and I need some honest-to-goodness samples. Bring me some red and brown mushrooms from the surface, would ya?",
  "gensokyolegacy/marisa/first_mushroom/option/complete": "Hand over the mushrooms.",
  "gensokyolegacy/marisa/first_mushroom/option/complete/handover": "Here you go.",
  "gensokyolegacy/marisa/first_mushroom/option/complete/reject": "Happy to help.",
  "gensokyolegacy/marisa/first_mushroom/option/follow_up": "Ask if she got what she needed.",
  "gensokyolegacy/marisa/first_mushroom/option/follow_up/end": "Not yet, still looking.",
  "gensokyolegacy/marisa/first_mushroom/option/start": "Talk about her mushroom research.",
  "gensokyolegacy/marisa/first_mushroom/option/start/accept": "Sure, I'll gather some.",
  "gensokyolegacy/marisa/first_mushroom/option/start/reject": "Ehh, sounds like a hassle.",
  "gensokyolegacy/marisa/first_mushroom/quest/desc": "Bring Marisa red and brown mushrooms from the surface.",
  "gensokyolegacy/marisa/first_mushroom/quest/title": "First Mushrooms",
  "gensokyolegacy/marisa/golden_apple/dialog/marisa/golden_apple/complete/dialog_1": "THIS! This is a treasure, human! Look at that glow — that's *real* lost technology. I'm gonna take this apart, learn every secret, and build it myself. You just made a huge breakthrough possible!",
  "gensokyolegacy/marisa/golden_apple/dialog/marisa/golden_apple/follow_up/dialog_1": "Any sign of one of those glowy apples yet? Check dungeon chests — they like to hide in there!",
  "gensokyolegacy/marisa/golden_apple/dialog/marisa/golden_apple/start/dialog_1": "One more thing, one more thing! Ever seen those fancy golden apples — the glowy ones, the 'enchanted' ones? The recipe's completely lost to this world. Nobody can craft 'em anymore. But *I* can figure it out! Bring me one as a prime sample, and I'll reverse-engineer the whole thing and share the knowledge. Whaddaya say?",
  "gensokyolegacy/marisa/golden_apple/option/complete": "Hand over the enchanted golden apple.",
  "gensokyolegacy/marisa/golden_apple/option/complete/handover": "I knew you could do it.",
  "gensokyolegacy/marisa/golden_apple/option/follow_up": "About the enchanted golden apple.",
  "gensokyolegacy/marisa/golden_apple/option/follow_up/end": "Haven't found one yet.",
  "gensokyolegacy/marisa/golden_apple/option/start": "Talk about the lost golden apple tech.",
  "gensokyolegacy/marisa/golden_apple/option/start/accept": "I'll try to find one.",
  "gensokyolegacy/marisa/golden_apple/option/start/reject": "Those are really rare.",
  "gensokyolegacy/marisa/golden_apple/quest/desc": "Bring Marisa an enchanted golden apple.",
  "gensokyolegacy/marisa/golden_apple/quest/title": "Enchanted Golden Apple",
  "gensokyolegacy/marisa/huge_mushroom/dialog/marisa/huge_mushroom/complete/dialog_1": "THESE! These are exactly what I needed! Feel that density, ze? There's some serious magic packed in here!",
  "gensokyolegacy/marisa/huge_mushroom/dialog/marisa/huge_mushroom/follow_up/dialog_1": "Got any of those big blocks yet? I wanna see how the cap connects to the stem!",
  "gensokyolegacy/marisa/huge_mushroom/dialog/marisa/huge_mushroom/start/dialog_1": "Whoa, hold on. Have ya seen the mushrooms around here? They're practically trees! I've never seen anything this huge — real whoppers. I tried pluckin' one, but it just shattered into little bits in my hands. There's gotta be a proper way to harvest the solid blocks. Think ya can bring me some whole giant mushroom blocks?",
  "gensokyolegacy/marisa/huge_mushroom/option/complete": "Hand over the mushroom blocks.",
  "gensokyolegacy/marisa/huge_mushroom/option/complete/handover": "Glad I could help.",
  "gensokyolegacy/marisa/huge_mushroom/option/follow_up": "About those mushroom blocks.",
  "gensokyolegacy/marisa/huge_mushroom/option/follow_up/end": "Still working on it.",
  "gensokyolegacy/marisa/huge_mushroom/option/start": "Talk about the giant mushrooms.",
  "gensokyolegacy/marisa/huge_mushroom/option/start/accept": "I'll bring you fresh blocks.",
  "gensokyolegacy/marisa/huge_mushroom/option/start/reject": "Can't you just break them yourself?",
  "gensokyolegacy/marisa/huge_mushroom/quest/desc": "Bring Marisa huge mushroom blocks.",
  "gensokyolegacy/marisa/huge_mushroom/quest/title": "Giant Mushrooms",
  "gensokyolegacy/marisa/nether_mushroom_prep/dialog/marisa/nether_mushroom_prep/complete/dialog_1": "Oh man, look at this! You can practically feel the fire in it! The flora in this world adapts to *everything*. That's amazing research material, ze!",
  "gensokyolegacy/marisa/nether_mushroom_prep/dialog/marisa/nether_mushroom_prep/follow_up/dialog_1": "Found any of that red Nether stuff yet? I hear it grows like a weed down there.",
  "gensokyolegacy/marisa/nether_mushroom_prep/dialog/marisa/nether_mushroom_prep/start/dialog_1": "Say — you've been to that creepy red world under the rock, right? The Nether, the fiery one? I hear the 'shrooms down there are somethin' else entirely. Never had the guts to go myself — all that heat and lava, yikes. But you've been there, haven't ya? Bring me some genuine Nether mushroom samples!",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/complete": "Hand over the nether mushrooms.",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/complete/handover": "Everything for science.",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/follow_up": "About the nether mushrooms.",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/follow_up/end": "The hoglins are guarding them.",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/start": "Talk about the Nether.",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/start/accept": "I've been to the Nether. I can do this.",
  "gensokyolegacy/marisa/nether_mushroom_prep/option/start/reject": "The Nether scares even me.",
  "gensokyolegacy/marisa/nether_mushroom_prep/quest/desc": "Bring Marisa nether mushroom samples.",
  "gensokyolegacy/marisa/nether_mushroom_prep/quest/title": "Nether Mushrooms",
  "gensokyolegacy/marisa/shroomlight/dialog/marisa/shroomlight/complete/dialog_1": "Ohhh, these little lights are *beautiful*! And look at the structure inside this stem! The magic must practically flow through here. This is gonna make my potions glow like nobody's business!",
  "gensokyolegacy/marisa/shroomlight/dialog/marisa/shroomlight/follow_up/dialog_1": "You gettin' any of that glowing stuff? I wanna see how it lights up!",
  "gensokyolegacy/marisa/shroomlight/dialog/marisa/shroomlight/start/dialog_1": "Okay, okay! You mentioned those giant *fungus trees* in the Nether — whole towers of mushroom! And they glow, right? The shroomlights? I've gotta see one up close. I need some samples: a few of those light-up shroomlight blocks and a chunk of the tree itself. Best research material money can't buy!",
  "gensokyolegacy/marisa/shroomlight/option/complete": "Hand over the shroomlights.",
  "gensokyolegacy/marisa/shroomlight/option/complete/handover": "Glad you like them.",
  "gensokyolegacy/marisa/shroomlight/option/follow_up": "About the shroomlights.",
  "gensokyolegacy/marisa/shroomlight/option/follow_up/end": "Still in the Nether.",
  "gensokyolegacy/marisa/shroomlight/option/start": "Talk about the fungus trees.",
  "gensokyolegacy/marisa/shroomlight/option/start/accept": "I'll bring back samples.",
  "gensokyolegacy/marisa/shroomlight/option/start/reject": "They're dangerous to climb.",
  "gensokyolegacy/marisa/shroomlight/quest/desc": "Bring Marisa shroomlights and nether fungus blocks.",
  "gensokyolegacy/marisa/shroomlight/quest/title": "Shroomlight & Fungus Trees",
  "gensokyolegacy/reimu/chat/dialog/reimu/chat/hi": "Hi!",
  "gensokyolegacy/reimu/chat/greeting": "Hi! What brings you to the shrine?",
  "gensokyolegacy/reimu/chat/option/bye": "Bye!",
  "gensokyolegacy/reimu/chat/starter/start": "Hi!",
  "gensokyolegacy/reimu/chat/trade": "I'd like to trade with you!",
  "gensokyolegacy/reimu/kill_zombie/dialog/reimu/kill_zombie/complete/dialog_1": "Thanks! Do you have flesh with you?",
  "gensokyolegacy/reimu/kill_zombie/dialog/reimu/kill_zombie/follow_up/dialog_1": "Thanks for your effort! I need more zombies killed",
  "gensokyolegacy/reimu/kill_zombie/dialog/reimu/kill_zombie/start/dialog_1": "Could you help me to kill some zombies?",
  "gensokyolegacy/reimu/kill_zombie/option/complete": "I killed all the zombies!",
  "gensokyolegacy/reimu/kill_zombie/option/complete/handover": "Sure!",
  "gensokyolegacy/reimu/kill_zombie/option/complete/reject": "Maybe next time",
  "gensokyolegacy/reimu/kill_zombie/option/follow_up": "I'm half way through killing zombies!",
  "gensokyolegacy/reimu/kill_zombie/option/follow_up/end": "Let me kill a few more",
  "gensokyolegacy/reimu/kill_zombie/option/start": "Anything I can help with?",
  "gensokyolegacy/reimu/kill_zombie/option/start/accept": "Sure!",
  "gensokyolegacy/reimu/kill_zombie/option/start/reject": "Maybe next time",
  "gensokyolegacy/reimu/kill_zombie/quest/desc": "Kill some zombies and collect rotten flesh for Reimu",
  "gensokyolegacy/reimu/kill_zombie/quest/title": "Zombie Slayer",
