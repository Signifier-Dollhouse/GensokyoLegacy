{
  "gensokyolegacy/reimu/shared/option/bye": "再见！",
  "gensokyolegacy/reimu/shared/option/daily_start": "有什么我能帮忙的吗？",
  "gensokyolegacy/reimu/shared/option/daily_accept": "我来搞定",
  "gensokyolegacy/reimu/shared/option/daily_reject": "也许晚点吧。",
  "gensokyolegacy/reimu/shared/option/daily_follow": "能再说一遍要做什么吗？",
  "gensokyolegacy/reimu/shared/option/daily_follow_end": "我正在办！",
  "gensokyolegacy/reimu/shared/option/daily_complete": "东西都拿来了～",
  "gensokyolegacy/reimu/shared/option/daily_handover": "给你",
  "gensokyolegacy/reimu/shared/dialog/daily_gotem": "哦，你拿来了？让我看看！",
  "gensokyolegacy/reimu/local_food/quest/title": "神社补给",
  "gensokyolegacy/reimu/local_food/quest/desc": "给灵梦带一些面包和蘑菇煲，让她熟悉这个世界的食物。",
  "gensokyolegacy/reimu/local_food/option/start": "聊聊食物。",
  "gensokyolegacy/reimu/local_food/option/follow_up": "问问食物。",
  "gensokyolegacy/reimu/local_food/option/complete": "交出食物。",
  "gensokyolegacy/reimu/local_food/option/start/reject": "下次吧。",
  "gensokyolegacy/reimu/local_food/option/start/accept": "我给你带饭来。",
  "gensokyolegacy/reimu/local_food/option/follow_up/end": "还在找。",
  "gensokyolegacy/reimu/local_food/option/complete/reject": "还没。",
  "gensokyolegacy/reimu/local_food/option/complete/handover": "给你。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/start/dialog_1": "我还在摸索这个世界什么东西能吃。带些面包和蘑菇煲来，让我了解一下这里的食物吧。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/start/reject/dialog_1": "在陌生世界里采集食物，可没写进巫女的手册。不过，我大概也能自己应付。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/start/accept/dialog_1": "好。面包和蘑菇煲。没什么讲究，先让这个巫女填饱肚子再说。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/follow_up/dialog_1": "食物找得怎么样了？",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/follow_up/end/dialog_1": "我一直看着村民吃东西，自己却只能干看着。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/complete/dialog_1": "回来了啊。希望你带来的是食物，不是又一笔捐款。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/complete/reject/dialog_1": "不急。我就继续做做蘑菇煲的白日梦吧。",
  "gensokyolegacy/reimu/local_food/dialog/reimu/local_food/complete/handover/dialog_1": "啊，终于有真正的食物了。谢谢。你是我来到这里后第一个能指望上的人。",
  "gensokyolegacy/reimu/hostile_loot/quest/title": "敌对生物分析",
  "gensokyolegacy/reimu/hostile_loot/quest/desc": "为灵梦猎杀僵尸和骷髅，收集它们的腐肉和骨头。",
  "gensokyolegacy/reimu/hostile_loot/requirement/zombie": "击杀僵尸",
  "gensokyolegacy/reimu/hostile_loot/requirement/skeleton": "击杀骷髅",
  "gensokyolegacy/reimu/hostile_loot/option/start": "主动提出猎取样本。",
  "gensokyolegacy/reimu/hostile_loot/option/follow_up": "问问狩猎。",
  "gensokyolegacy/reimu/hostile_loot/option/complete": "交出样本。",
  "gensokyolegacy/reimu/hostile_loot/option/start/reject": "下次吧。",
  "gensokyolegacy/reimu/hostile_loot/option/start/accept": "我来猎杀僵尸和骷髅。",
  "gensokyolegacy/reimu/hostile_loot/option/follow_up/end": "还在猎。",
  "gensokyolegacy/reimu/hostile_loot/option/complete/reject": "还没。",
  "gensokyolegacy/reimu/hostile_loot/option/complete/handover": "样本在这里。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/start/dialog_1": "那些行尸和咔嗒作响的骷髅老是来偷袭我。它们不算真正的妖怪，但我想研究一下。带些腐肉和骨头回来吧。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/start/reject/dialog_1": "确实有点危险。不过你在这里活得比我久。准备好了再去也行。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/start/accept/dialog_1": "好。两种各十只，再带些腐肉和骨头回来。够我研究就行。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/follow_up/dialog_1": "猎得怎么样了？",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/follow_up/end/dialog_1": "样本找到了吗？腐肉和骨头应该能告诉我不少东西。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/complete/dialog_1": "回来了。希望你没变成它们的一员。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/complete/reject/dialog_1": "不急。只是别让它们啃到你。",
  "gensokyolegacy/reimu/hostile_loot/dialog/reimu/hostile_loot/complete/handover/dialog_1": "很好。现在我可以拿这些和我熟悉的妖怪比较了。辛苦你跑这一趟。",
  "gensokyolegacy/reimu/talisman_materials/quest/title": "符札材料",
  "gensokyolegacy/reimu/talisman_materials/quest/desc": "为灵梦的符札带来纸和红石粉。",
  "gensokyolegacy/reimu/talisman_materials/option/start": "聊聊符札。",
  "gensokyolegacy/reimu/talisman_materials/option/follow_up": "问问符札。",
  "gensokyolegacy/reimu/talisman_materials/option/complete": "交出材料。",
  "gensokyolegacy/reimu/talisman_materials/option/start/reject": "为什么要红石粉？",
  "gensokyolegacy/reimu/talisman_materials/option/start/accept": "我来收集纸和红石粉。",
  "gensokyolegacy/reimu/talisman_materials/option/follow_up/end": "还在收集。",
  "gensokyolegacy/reimu/talisman_materials/option/complete/reject": "还没。",
  "gensokyolegacy/reimu/talisman_materials/option/complete/handover": "纸和红石粉在这里。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/start/dialog_1": "这里的纸很好折，这种红石粉又会发光，还充满力量。我可以拿它当朱砂墨，做出这个世界的符札。带些来吧。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/start/reject/dialog_1": "它是红的，会发光，而且充满力量。拿来当朱砂墨已经够好了。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/start/accept/dialog_1": "好。纸用来折，红石用来当墨。这样神社的库存就够了。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/follow_up/dialog_1": "材料找齐了吗？",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/follow_up/end/dialog_1": "我想看看这些新符札到底好不好用。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/complete/dialog_1": "带来了啊。让我看看。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/complete/reject/dialog_1": "好啦，好啦。符札可以再等等。",
  "gensokyolegacy/reimu/talisman_materials/dialog/reimu/talisman_materials/complete/handover/dialog_1": "很好。现在可以做新的符札了。也给你做几张。",
  "gensokyolegacy/reimu/ender_materials/quest/title": "末影材料",
  "gensokyolegacy/reimu/ender_materials/quest/desc": "为灵梦带来一颗末影珍珠和一颗末影之眼，用于她的隙间研究。",
  "gensokyolegacy/reimu/ender_materials/option/start": "提起末影人在四处瞬移的事。",
  "gensokyolegacy/reimu/ender_materials/option/follow_up": "问问隙间。",
  "gensokyolegacy/reimu/ender_materials/option/complete": "交出末影材料。",
  "gensokyolegacy/reimu/ender_materials/option/start/reject": "下次吧。",
  "gensokyolegacy/reimu/ender_materials/option/start/accept": "我去找末影材料。",
  "gensokyolegacy/reimu/ender_materials/option/follow_up/end": "还在找。",
  "gensokyolegacy/reimu/ender_materials/option/complete/reject": "还没。",
  "gensokyolegacy/reimu/ender_materials/option/complete/handover": "珍珠和末影之眼在这里。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/start/dialog_1": "它们靠扭曲空间在世界里闪来闪去，对吧？我想把这招用在我的隙间传送门上。这个世界的末影珍珠能像迷你隙间一样扭曲空间，而末影之眼可以锁定回家的路。各带一个来——我觉得靠它们就能把路线定下来。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/start/reject/dialog_1": "它们确实很难得。等手头有富余了再来吧。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/start/accept/dialog_1": "那就一颗珍珠和一颗末影之眼。都是稀罕物，不过这正是我需要的锚点。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/follow_up/dialog_1": "找到末影材料了吗？",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/follow_up/end/dialog_1": "珍珠是夜里那些紫色小淘气掉的。末影之眼嘛，你得往更深的地方找了。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/complete/dialog_1": "让我看看你带来了什么。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/complete/reject/dialog_1": "不急。只要保管好就行。",
  "gensokyolegacy/reimu/ender_materials/dialog/reimu/ender_materials/complete/handover/dialog_1": "太棒了。有了这些，我就能锚定一道真正的隙间。回家的路又近了一步。",
  "gensokyolegacy/reimu/ominous_banner/quest/title": "掠夺者的旗帜",
  "gensokyolegacy/reimu/ominous_banner/quest/desc": "为灵梦带回一面掠夺者首领的不祥旗帜。",
  "gensokyolegacy/reimu/ominous_banner/option/start": "聊聊掠夺者。",
  "gensokyolegacy/reimu/ominous_banner/option/follow_up": "问问旗帜。",
  "gensokyolegacy/reimu/ominous_banner/option/complete": "交出旗帜。",
  "gensokyolegacy/reimu/ominous_banner/option/start/reject": "下次吧。",
  "gensokyolegacy/reimu/ominous_banner/option/start/accept": "我去找一个袭击队长。",
  "gensokyolegacy/reimu/ominous_banner/option/follow_up/end": "还在找。",
  "gensokyolegacy/reimu/ominous_banner/option/complete/reject": "还没。",
  "gensokyolegacy/reimu/ominous_banner/option/complete/handover": "旗帜在这里。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/start/dialog_1": "大家一直在说掠夺者——一群带着黑白旗帜的武装家伙。带一面他们首领的旗子给我。我想看看那上面到底是什么意思。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/start/reject/dialog_1": "说到底也只是拿着武器的人类。准备好对付他们以后再来吧。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/start/accept/dialog_1": "好。他们的首领会带着那种不祥旗帜。解决掉一个，把旗子带回来。不过要小心，他们会留下一个不祥的印记。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/follow_up/dialog_1": "找到他们的首领了吗？",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/follow_up/end/dialog_1": "去看看前哨站和巡逻队。你最有可能在那里找到他们。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/complete/dialog_1": "就是这个。让我看看这面怪旗子到底在说什么。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/complete/reject/dialog_1": "慢慢来。我会在这里等着。",
  "gensokyolegacy/reimu/ominous_banner/dialog/reimu/ominous_banner/complete/handover/dialog_1": "就是它。我会研究这群掠夺者到底靠什么联系在一起。然后再想想该怎么收拾他们。",
  "gensokyolegacy/reimu/raid/quest/title": "击退袭击",
  "gensokyolegacy/reimu/raid/quest/desc": "带着灵梦的印记进入村子，击退掠夺者。",
  "gensokyolegacy/reimu/raid/requirement/raid": "赢得一场袭击战",
  "gensokyolegacy/reimu/raid/option/start": "聊聊计划。",
  "gensokyolegacy/reimu/raid/option/follow_up": "问问袭击。",
  "gensokyolegacy/reimu/raid/option/complete": "告诉灵梦袭击结束了。",
  "gensokyolegacy/reimu/raid/option/start/reject": "你自己不能去吗？",
  "gensokyolegacy/reimu/raid/option/start/accept": "我来击退袭击。",
  "gensokyolegacy/reimu/raid/option/follow_up/end": "再盖一个印记。",
  "gensokyolegacy/reimu/raid/option/complete/reject": "还没。",
  "gensokyolegacy/reimu/raid/option/complete/handover": "掠夺者都被赶走了。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/start/dialog_1": "我弄明白那个印记了。我的符札可以重新做出它。我把印记放到你身上；你进村，把掠夺者引出来，再把他们赶走。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/start/reject/dialog_1": "我还有神社的事要做。你更了解这个世界，所以战斗就交给你了。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/start/accept/dialog_1": "好了。印记已经在你身上了。进村把他们引出来，然后把所有掠夺者都赶走。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/follow_up/dialog_1": "村子还撑得住，但印记正在消退。要再来一次吗？我可以再给你盖上一个新的。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/follow_up/end/dialog_1": "好了。进村把他们引出来，然后把所有掠夺者都赶走。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/complete/dialog_1": "那些一波波的家伙停下来了？很好。看来计划成功了。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/complete/reject/dialog_1": "还没结束？那就保持警惕。他们没那么容易放弃。",
  "gensokyolegacy/reimu/raid/dialog/reimu/raid/complete/handover/dialog_1": "你把他们全赶走了。我就知道把他们引进村子会有用。给——这把结界伞拿好，为接下来要来的东西做个准备吧。",
  "gensokyolegacy/reimu/daily_food/quest/title": "神社补给",
  "gensokyolegacy/reimu/daily_food/quest/desc": "给灵梦带些神社需要的物资。",
  "gensokyolegacy/reimu/daily_food/dialog/reimu/daily_food/start/dialog_1": "捐款箱又空了，而且我也饿了。带几样神社用得上的东西来吧。",
  "gensokyolegacy/reimu/daily_food/dialog/reimu/daily_food/start/reject/dialog_1": "饿着肚子的巫女可没精神干活。随你。",
  "gensokyolegacy/reimu/daily_food/dialog/reimu/daily_food/start/accept/dialog_1": "很好。带一批像样的回来。",
  "gensokyolegacy/reimu/daily_food/dialog/reimu/daily_food/follow_up/dialog_1": "捐款箱又空了——记得带一批像样的补给回来。",
  "gensokyolegacy/reimu/daily_food/dialog/reimu/daily_food/follow_up/end/dialog_1": "不急。记得带些有用的回来。",
  "gensokyolegacy/reimu/daily_food/dialog/reimu/daily_food/complete/handover/dialog_1": "正好是神社需要的。谢了。",
  "gensokyolegacy/reimu/daily_hunt/quest/title": "怪物清剿",
  "gensokyolegacy/reimu/daily_hunt/quest/desc": "清剿怪物，并给灵梦带回一些战利品。",
  "gensokyolegacy/reimu/daily_hunt/requirement/kill": "击杀敌对生物",
  "gensokyolegacy/reimu/daily_hunt/dialog/reimu/daily_hunt/start/dialog_1": "神社附近最近总有东西惹麻烦。把那些怪物清掉，再带些战利品回来。",
  "gensokyolegacy/reimu/daily_hunt/dialog/reimu/daily_hunt/start/reject/dialog_1": "它们只会越来越嚣张。不过随你。",
  "gensokyolegacy/reimu/daily_hunt/dialog/reimu/daily_hunt/start/accept/dialog_1": "很好。去把它们清干净。",
  "gensokyolegacy/reimu/daily_hunt/dialog/reimu/daily_hunt/follow_up/dialog_1": "神社附近最近又有东西惹麻烦——把怪物清掉，带回战利品，记得吗？",
  "gensokyolegacy/reimu/daily_hunt/dialog/reimu/daily_hunt/follow_up/end/dialog_1": "在外面小心点。我可需要你完完整整地回来。",
  "gensokyolegacy/reimu/daily_hunt/dialog/reimu/daily_hunt/complete/handover/dialog_1": "又能让大家安稳睡一晚。谢了。",
  "gensokyolegacy/reimu/daily_talisman/quest/title": "符札补给",
  "gensokyolegacy/reimu/daily_talisman/quest/desc": "为灵梦补充符札库存，带上纸和红石粉。",
  "gensokyolegacy/reimu/daily_talisman/dialog/reimu/daily_talisman/start/dialog_1": "符札库存又快见底了。纸和红石，还是之前那些。",
  "gensokyolegacy/reimu/daily_talisman/dialog/reimu/daily_talisman/start/reject/dialog_1": "没库存就没法做结界。随你。",
  "gensokyolegacy/reimu/daily_talisman/dialog/reimu/daily_talisman/start/accept/dialog_1": "很好。补好库存，我就能继续给神社做结界。",
  "gensokyolegacy/reimu/daily_talisman/dialog/reimu/daily_talisman/follow_up/dialog_1": "符札库存又见底了——纸用来折，红石用来当墨，记得吗。",
  "gensokyolegacy/reimu/daily_talisman/dialog/reimu/daily_talisman/follow_up/end/dialog_1": "符札架子都快空了。",
  "gensokyolegacy/reimu/daily_talisman/dialog/reimu/daily_talisman/complete/handover/dialog_1": "很好。架子又补满了。",
  "gensokyolegacy/reimu/daily_raid/quest/title": "袭击防御",
  "gensokyolegacy/reimu/daily_raid/quest/desc": "带着灵梦的印记赢得一场袭击战，保护村子。",
  "gensokyolegacy/reimu/daily_raid/requirement/raid": "赢得一场袭击战",
  "gensokyolegacy/reimu/daily_raid/dialog/reimu/daily_raid/start/dialog_1": "新的印记准备好了，又有一个村子需要保护。准备再来一次袭击战吗？",
  "gensokyolegacy/reimu/daily_raid/dialog/reimu/daily_raid/start/reject/dialog_1": "印记会留着。等你准备好，掠夺者还在那里。",
  "gensokyolegacy/reimu/daily_raid/dialog/reimu/daily_raid/start/accept/dialog_1": "给你印记，和上次一样。进村、守住阵线，把他们赶出去。",
